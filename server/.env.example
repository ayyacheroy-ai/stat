# Optional — the app works with no .env file at all for local dev (SQLite,
# see prisma/schema.prisma). These are only here if you want to override the
# defaults below.

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (e.g. the Expo dev server)
CORS_ORIGINS="http://localhost:8081,exp://127.0.0.1:19000"
