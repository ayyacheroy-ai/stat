{
  "name": "pitchline-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pitchline backend API — owns real (tracker-sourced) data: players, matches, statistics, processing jobs, and media pointers. See README.md for the domain model and API contract.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
